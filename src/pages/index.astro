---
//index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExternalLink from '@/components/base/ExternalLink.astro';
import { IconHeadphones, IconWreckingBall } from '@tabler/icons-astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const MAX_POSTS = 5;
const posts: CollectionEntry<'blog'>[] = await getCollection('blog');

const latestPosts = posts
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, MAX_POSTS);
const pageTitle = ``;
---

<BaseLayout hasOwnTitle={true} pageTitle={pageTitle} mainClass="homepage">
    <div class="listened fade-in">
        <IconHeadphones aria-hidden="true" />

        <a
            class="track"
            href="https://listenbrainz.org/user/flipse"
            aria-label="See my latest scrobbled songs on my ListenBrainz profile (opens in new tab)"
            target="_blank"
            rel="noopener noreferrer">
            Loading last played track…
        </a>
    </div>
    <div class="flow">
        <h1 class="fade-in">Hey, so I'm Flipse, or whatever.</h1>

        <p class="intro fade-in">
            <span class="bold">Just kidding, there's nothing nonchalant about me.</span> A late-30s nerd of music
            and [insert current obsession]. Disabled/retired, but occasionally doing NASA's <ExternalLink
                href="https://science.nasa.gov/citizen-science/"
                label="homework"
            /> and picking fights with quantum physics just for kicks. I will recite the entire script of the 1998
            hit movie <em>Armageddon</em> if I like you. The 'tism is strong with this one.
        </p>

        <p class="intro fade-in">
            I have created <ExternalLink href="https://mournstera.tumblr.com/" label="Tumblr" /> themes for 15+
            years, but right-clicked <em>view source</em> on a website sometime around 1999 and got my own domain
            at 12. I dig concerts, D&amp;D, <dfn
                title="The smell of rain hitting warm ground, pavement, and asphalt">petrichor</dfn
            >, and desk setups.
        </p>

        <p class="intro fade-in">
            I aim to be a cosmic inconvenience for mediocre folk. It's a post-people-pleaser path, and it's
            rocky. So anyway, I can be found at {' '}
            <ExternalLink href="https://bsky.app/profile/mournstera.wtf" label="Bluesky" />,{' '}
            <ExternalLink href="https://instagram.com/mournstera" label="Instagram" />, and{' '}
            <ExternalLink href="https://github.com/flipsewtf" label="GitHub" />.
        </p>
    </div>

    <section class="blog">
        <h2 class="sr-only">Latest posts</h2>
        <ul class="post-list fade-in">
            {
                latestPosts.map((post) => (
                    <li>
                        <time datetime={post.data.pubDate.toISOString()}>
                            {new Intl.DateTimeFormat('en-GB', {
                                day: '2-digit',
                                month: '2-digit',
                                year: '2-digit',
                            })
                                .formatToParts(post.data.pubDate)
                                .filter((part) => part.type !== 'literal')
                                .map((part) => part.value)
                                .join('.')}
                        </time>
                        <div>
                            <h3>
                                <a href={`/blog/${post.id}`}>{post.data.title}</a>
                            </h3>
                            <p class="desc">{post.data.description}</p>
                        </div>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>
<style>
    .listened {
        animation-delay: 0.1s;
        margin-left: var(--space-2px);
        font-weight: 480;
    }
    .listened svg {
        height: 1.25rem;
        width: 1.25rem;
        stroke-width: 2;
        stroke: var(--accent);
        vertical-align: bottom;
        margin-right: var(--space-4px);
    }
    a.track {
        line-height: var(--leading-heading);
        font-family: var(--font-mono);
        color: var(--text-muted);
        font-size: var(--text-sm);
    }
    a.track:hover {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: var(--underline-offset);
        text-decoration-thickness: var(--underline-thickness);
    }

    h1 {
        line-height: 1;
        margin-block: var(--space-lg);
        animation-delay: 0.5s;
        text-wrap: balance;
    }

    p.intro {
        animation-delay: 0.15s;
    }

    span.bold {
        font-weight: 550;
        color: var(--text-alt);
    }
    dfn {
        font-style: normal;
        cursor: help;
    }
    a.social {
        display: inline-block;
    }

    a.social svg {
        width: 1.125rem;
        height: 1.125rem;
        vertical-align: middle;
        display: inline;
        stroke-width: 2;
        margin-right: var(--space-1px);
        color: var(--text-muted);
    }

    section.blog {
        border-top: var(--space-1px) solid var(--lines);
        margin-block-start: var(--space-lg);
        padding-block-start: var(--space-xl);
    }
    ul.post-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        animation-delay: 0.25s;
    }
    ul.post-list li {
        display: grid;
        grid-template-columns: 1fr;
        align-items: start;
        gap: var(--space-md);
        justify-items: start;
    }
    ul.post-list li time {
        font-family: var(--font-mono);
        margin-top: var(--space-3px);
        font-size: var(--text-sm);
        font-weight: 500;
    }
    ul.post-list li h3 {
        font-weight: 630;
    }
    ul.post-list li h3 a {
        text-decoration: underline;
        text-decoration-color: var(--text);
        color: var(--text-alt);
        overflow-wrap: anywhere;
        text-decoration-skip-ink: auto;
        text-decoration-style: dotted;
        text-underline-offset: var(--underline-offset);
        text-decoration-thickness: var(--underline-thickness);
    }
    ul.post-list li h3 a:hover {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: var(--underline-offset);
        text-decoration-thickness: var(--underline-thickness);
    }
    ul.post-list li p.desc {
        margin-top: var(--space-4px);
        font-size: var(--text-sm);
    }

    @media (width > 48rem) {
        ul.post-list {
            gap: var(--space-md);
        }
        ul.post-list li {
            grid-template-columns: auto 1fr;
        }
    }
</style>

<script src="/scripts/scrobble.js" defer></script>
