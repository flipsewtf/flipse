---
//index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Scrobble from '@/components/other/Scrobble.astro';
import Intro from '@/components/other/Intro.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { IconCaretRightFilled } from '@tabler/icons-astro';

const MAX_POSTS = 5;
const posts: CollectionEntry<'blog'>[] = await getCollection('blog');

const latestPosts = posts
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, MAX_POSTS);
const pageTitle = ``;
---

<BaseLayout hasOwnTitle={true} pageTitle={pageTitle} mainClass="homepage">
    <Intro />
    <Scrobble />
    <hr />
    <section>
        <h2>Latest words</h2>

        <ul class="post-list">
            {
                latestPosts.map((post) => (
                    <li>
                        <time datetime={post.data.pubDate.toISOString()}>
                            {new Intl.DateTimeFormat('en-GB', {
                                day: '2-digit',
                                month: '2-digit',
                                year: '2-digit',
                            })
                                .formatToParts(post.data.pubDate)
                                .filter((part) => part.type !== 'literal')
                                .map((part) => part.value)
                                .join('.')}
                        </time>
                        <div>
                            <h3>
                                <a class="prose-link" href={`/blog/${post.id}`}>
                                    {post.data.title}
                                </a>
                            </h3>
                            <p class="desc">{post.data.description}</p>
                        </div>
                    </li>
                ))
            }
        </ul>
        <a class="view-all" href="/blog"
            >View all <IconCaretRightFilled aria-hidden="true" /></a
        >
    </section>
</BaseLayout>

<style>
    h2 {
        font-size: var(--text-h1);
        margin-block-end: var(--space-xl);
        text-wrap: balance;
        margin-inline-start: var(--offset-margin-text);
        letter-spacing: -0.125rem;
        font-weight: 400;
    }

    ul.post-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
    }
    ul.post-list time {
        display: block;
        font-family: var(--font-family--mono);
        margin-bottom: var(--space-sm);
        font-size: var(--text-sm);
        font-weight: 500;
    }
    ul.post-list p {
        margin-top: var(--space-4px);
        font-size: var(--text-sm);
        color: var(--text-muted);
    }
    a.view-all {
        display: inline-flex;
        align-items: center;
        text-transform: uppercase;
        margin-top: var(--space-lg);
        font-family: var(--font-family--heading);
        font-weight: 600;
    }
    a.view-all svg {
        fill: var(--text);
        transform: translateX(0);
        transition: var(--transition-ease);
    }

    a.view-all:hover svg {
        transform: translateX(0.25rem);
    }
</style>
