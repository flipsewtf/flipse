---
//index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExternalLink from '@/components/base/ExternalLink.astro';
import {
    IconHeadphones,
    IconBrandBluesky,
    IconBrandInstagram,
    IconBrandTumblr,
    IconBrandGithub,
} from '@tabler/icons-astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const MAX_POSTS = 5;
const posts: CollectionEntry<'blog'>[] = await getCollection('blog');

const latestPosts = posts
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, MAX_POSTS);
const pageTitle = ``;
---

<BaseLayout hasOwnTitle={true} pageTitle={pageTitle} mainClass="homepage">
    <div class="listened fade-in">
        <IconHeadphones aria-hidden="true" />

        <a
            class="track"
            href="https://listenbrainz.org/user/flipse"
            aria-label="See my latest scrobbled songs on my ListenBrainz profile (opens in new tab)"
            target="_blank"
            rel="noopener noreferrer">
            Loading last played track…
        </a>
    </div>
    <div class="flow">
        <h1 class="fade-in">Hey, so I'm Flipse, or whatever.</h1>
        <p class="intro fade-in">
            <span class="bold">Just kidding, there's nothing nonchalant about me.</span> I have created Tumblr
            themes for 15+ years, but right-clicked <em>view source</em> in 1999. Autistic & bi musichead. Disabled/retired,
            but occasionally doing NASA's <ExternalLink
                href="https://science.nasa.gov/citizen-science/"
                label="homework"
            />. I will recite the entire script of the 1998 hit movie <em>Armageddon</em> if I like you. The 'tism
            is strong with this one.
        </p>
    </div>

    <nav class="socials fade-in" aria-label="Social media">
        <a
            href="https://bsky.app/profile/mournstera.wtf"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow on Bluesky (opens in new tab)">
            <IconBrandBluesky />
        </a>

        <a
            href="https://instagram.com/mournstera"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow on Instagram (opens in new tab)">
            <IconBrandInstagram />
        </a>

        <a
            href="https://mournstera.tumblr.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow on Tumblr (opens in new tab)">
            <IconBrandTumblr />
        </a>

        <a
            href="https://github.com/flipsewtf"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow on Github (opens in new tab)">
            <IconBrandGithub />
        </a>
    </nav>

    <section class="blog">
        <h2 class="sr-only">Latest posts</h2>
        <ul class="post-list fade-in">
            {
                latestPosts.map((post) => (
                    <li>
                        <time datetime={post.data.pubDate.toISOString()}>
                            {new Intl.DateTimeFormat('en-GB', {
                                day: '2-digit',
                                month: '2-digit',
                                year: '2-digit',
                            })
                                .formatToParts(post.data.pubDate)
                                .filter((part) => part.type !== 'literal')
                                .map((part) => part.value)
                                .join('.')}
                        </time>
                        <div>
                            <h3>
                                <a href={`/blog/${post.id}`}>{post.data.title}</a>
                            </h3>
                            <p class="desc">{post.data.description}</p>
                        </div>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>

<style>
    .listened {
        animation-delay: 0.1s;
        display: flex;
        align-items: center;
        gap: var(--space-4px);
        font-size: var(--text-xs);
        margin-left: var(--space-2px);
    }
    .listened svg {
        height: 1.125rem;
        width: 1.125rem;
        stroke-width: 2;
        stroke: var(--accent);
    }
    a.track {
        line-height: var(--leading-heading);
        font-family: var(--font-mono);
        color: var(--text-muted);
    }
    a.track:hover {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: var(--underline-offset);
        text-decoration-thickness: var(--underline-thickness);
    }

    h1 {
        font-size: 3.25rem;
        line-height: 1;
        margin-block: var(--space-lg);
        letter-spacing: -0.125rem;
        margin-left: var(--offset-margin);
        animation-delay: 0.5s;
    }

    p.intro {
        animation-delay: 0.15s;
    }

    span.bold {
        font-weight: 550;
        color: var(--text-alt);
    }
    nav.socials {
        animation-delay: 0.15s;
        margin: var(--space-lg);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2px);
    }
    nav.socials svg {
        position: absolute;
        transition: transform var(--transition--smooth);
    }

    nav.socials a {
        color: var(--accent);
        display: inline-flex;
        width: var(--space-xl);
        height: var(--space-xl);
        align-items: center;
        justify-content: center;
    }

    nav.socials a:hover {
        color: var(--accent);
    }

    nav.socials a:hover svg {
        transform: scale(1.2);
    }

    section.blog {
        border-top: var(--space-1px) solid var(--lines);
        margin-block: var(--space-xl);
        padding-block: var(--space-xl);
    }
    ul.post-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        animation-delay: 0.25s;
    }
    ul.post-list li {
        display: grid;
        grid-template-columns: 5rem 1fr;
        align-items: start;
        gap: var(--space-md);
    }
    ul.post-list li time {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        padding: var(--space-xs);
        background-color: var(--bg-alt);
        border-radius: var(--radius-sm);
        text-align: center;
        margin-left: var(--offset-margin);
    }
    ul.post-list li h3 {
        font-family: var(--font-body);
        font-weight: 630;
    }
    ul.post-list li h3 a {
        text-decoration: underline;
        text-decoration-color: var(--text-muted);
        color: var(--text-alt);
        overflow-wrap: anywhere;
        text-decoration-skip-ink: auto;
        text-decoration-style: dotted;
        text-underline-offset: var(--underline-offset);
        text-decoration-thickness: var(--underline-thickness);
    }
    ul.post-list li h3 a:hover {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: var(--underline-offset);
        text-decoration-thickness: var(--underline-thickness);
    }
    ul.post-list li p.desc {
        color: var(--text-muted);
        margin-top: var(--space-4px);
        font-size: var(--text-sm);
    }

    @media (min-width: 48rem) {
    }
</style>

<script src="/scripts/scrobble.js" defer></script>
