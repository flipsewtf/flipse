---
//index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Scrobble from '@/components/other/Scrobble.astro';
import Intro from '@/components/other/Intro.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const MAX_POSTS = 5;
const posts: CollectionEntry<'blog'>[] = await getCollection('blog');

const latestPosts = posts
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, MAX_POSTS);
const pageTitle = ``;
---

<BaseLayout hasOwnTitle={true} pageTitle={pageTitle} mainClass="homepage">
    <Scrobble />
    <Intro />
</BaseLayout>
