---
// colophon.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExternalLink from '@/components/base/ExternalLink.astro';

const pageTitle = `Colophon`;
---

<BaseLayout hasOwnTitle={false} pageTitle={pageTitle}>
    <article class="flow">
        <dl class="definition flow">
            <dt><h2>Mournstera</h2></dt>
            <dd class="flow">
                <span class="pronunciation ipa">/ˈmɔːn.stə.rə/</span>
                <span class="pronunciation simple">(“morn-ster-uh”)</span>
                <span class="definition-description">
                    From <i>monstera</i> + <i>mourn</i>. Blending grief and growth.
                </span>
            </dd>
        </dl>
    </article>

    <article class="flow page">
        <h2>Design & Build</h2>

        <p>
            This site is built with Astro, served as static files via Cloudflare, with the source hosted on
            GitHub. Set in Inter, Roboto Condensed, Roboto Mono. Icons courtesy of the Tabler icon library.
        </p>
        <p>
            This is a personal project, archiving and going back to owning my content like in the noughties.
            I'm leaning into learning with transparency around my explorations. Mournstera.wtf went live
            April 2026 and aims to meet WCAG 2.1 AA accessibility standards but is very much a work in
            progress.
        </p>
    </article>

    <article class="flow page">
        <h2>Policy</h2>
        <p>
            No personal data, no cookies. The only analytics are Cloudflare's basic traffic metrics, and
            honestly I couldn't care less about those.
        </p>
    </article>

    <article class="flow page">
        <h2>Credits</h2>

        <p>
            <ExternalLink href="https://piccalil.li/blog/my-favourite-3-lines-of-css/" label="piccalil.li" /> saved
            my flow margin-ass.
        </p>
    </article>
</BaseLayout>

<style>
    article:not(:last-of-type) {
        margin-bottom: var(--space-2xl);
    }
    .definition {
        border-block: var(--space-1px) solid var(--lines);
        padding: var(--space-lg);
        background-color: var(--bg-muted);
        margin-inline: var(--space-1px);

        dd {
            padding-left: var(--space-sm);
        }

        h2 {
            font-family: var(--font-mono);
            font-size: var(--text-xl);
        }

        .pronunciation {
            display: block;
            font-family: var(--font-mono);
            font-size: var(--text-sm);
            color: var(--text);

            &.simple {
                font-style: italic;
            }
        }

        .definition-description {
            display: block;
        }
    }
</style>
