---
//about.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExternalLink from '@/components/base/ExternalLink.astro';
const pageTitle = 'About Flipse';
---

<BaseLayout pageTitle={pageTitle}>
    <div class="intro-wrapper">
        <div class="portrait">
            <img class="bio-light" src="/assets/images/bio.gif" alt="" />
        </div>

        <article class="flow">
            <p>
                Flipse is a late 30s autistic & bi musichead, disability pensioner, occasionally
                doing NASA's <ExternalLink
                    href="https://science.nasa.gov/citizen-science/"
                    label="homework"
                />.
            </p>

            <p>
                Lover of concerts, Doctor Who, D&D and <a class="page-link" href="/uses"
                    >desk setups</a
                >.
            </p>

            <p>
                I've been releasing accessibility-first <ExternalLink
                    href="https://mournstera.tumblr.com/"
                    label="Tumblr themes"
                /> for 15+ years and been a fandom girl since the early Livejournal days.
            </p>
        </article>
    </div>
</BaseLayout>

<style>
    .intro-wrapper {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
        gap: var(--space--lg) var(--space--xl);
    }
    .portrait {
        margin-inline: auto;
        width: fit-content;
    }

    .portrait img {
        shape-rendering: geometricPrecision;
        border-radius: var(--radius--lg);
        border: var(--px2) solid var(--text-alt);
        object-fit: none;
    }

    :global([data-theme='light']) .portrait img {
        mix-blend-mode: darken;
    }

    :global([data-theme='dark']) .portrait img {
        filter: brightness(0.82);
    }

    /* DESKTOP */
    @media (min-width: 48rem) {
        .portrait {
            margin-inline: none;
            width: auto;
        }
        .portrait img {
            width: 100%;
            height: 100%;
            aspect-ratio: 9/16;
        }
    }
</style>
