---
//index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExternalLink from '@/components/base/ExternalLink.astro';

const pageTitle = 'About';
---

<BaseLayout hasOwnTitle={true} pageTitle={pageTitle}>
    <h1>Hey, so I'm Flipse, or whatever</h1>

    <div class="flow">
        <p class="intro">
            <span class="bold">Just kidding, there's nothing nonchalant about me.</span> A late-30s
            nerd of music and [insert current obsession]. Disabled/retired, but occasionally
            doing NASA's <ExternalLink
                href="https://science.nasa.gov/citizen-science/"
                label="homework"
            /> and picking fights with quantum physics just for kicks. I will recite the entire
            script of the 1998 hit movie <em>Armageddon</em> if I like you. The 'tism is strong
            with this one.
        </p>

        <p class="intro">
            I right-clicked <em>view source</em> sometime around 1999 and got my own domain
            quickly after. I have recently, after 15+ years of creating <ExternalLink
                href="https://mournstera.tumblr.com/"
                label="Tumblr"
            /> themes, left that behind. I am now here.
        </p>

        <p class="intro">
            I dig concerts, D&amp;D, <dfn
                title="The smell of rain hitting warm ground, pavement, and asphalt"
                >petrichor</dfn
            >, and desk setups. So anyway, I can be found at {' '}
            <ExternalLink href="https://bsky.app/profile/flipse.wtf" label="Bluesky" />,{
                ' '
            }
            <ExternalLink
                href="https://discord.com/users/910190469726740480"
                label="Discord"
            />,{' '}
            <ExternalLink href="https://github.com/flipsewtf" label="GitHub" />, and{' '}
            <ExternalLink href="https://instagram.com/flipse.wtf" label="Instagram" />.
        </p>
    </div>
</BaseLayout>
<style>
    span.bold {
        font-weight: 550;
        color: var(--text-alt);
    }
    dfn {
        font-style: normal;
        cursor: help;
    }
    a.social {
        display: inline-block;
    }

    a.social svg {
        width: 1.125rem;
        height: 1.125rem;
        vertical-align: middle;
        display: inline;
        stroke-width: 2;
        margin-right: var(--space-1px);
        color: var(--text-muted);
    }
</style>
