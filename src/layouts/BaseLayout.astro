---
// BaseLayout.astro
import BaseHead from '@/components/base/BaseHead.astro';
import ThemeToggle from '@/components/base/ThemeToggle.astro';
import Sidebar from '@/components/base/Sidebar.astro';
import SidebarMobile from '@/components/base/SidebarMobile.astro';

import { siteDescription } from '@/assets/data/site-desc';

const {
    pageTitle = 'Mournstera',
    seoTitle,
    pageDescription = siteDescription,
    pageImage = '/social-default.png',
    mainClass = '',
    hasOwnTitle = false,
} = Astro.props;
---

<html lang="en">
    <head>
        <BaseHead title={seoTitle ?? pageTitle} description={pageDescription} image={pageImage} />
    </head>
    <body>
        <SidebarMobile />

        <ThemeToggle />

        <div class="grid-line grid-sidebar"></div>
        <div class="grid-line grid-content-left"></div>
        <div class="grid-line grid-content-right"></div>
        <div class="grid-line grid-bar"></div>

        <main class:list={[mainClass]}>
            <aside class:list={['sidebar', { 'fade-in': mainClass === 'homepage' }]}>
                <div class="sidebar-inner">
                    <Sidebar />
                </div>
            </aside>
            <section class="main-content">
                {!hasOwnTitle && pageTitle && <h1>{pageTitle}</h1>}
                <slot />
            </section>
        </main>
    </body>
</html>
