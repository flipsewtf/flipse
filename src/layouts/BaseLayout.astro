---
// BaseLayout.astro
import BaseHead from '@/components/base/BaseHead.astro';
import ThemeToggle from '@/components/base/ThemeToggle.astro';
import Sidebar from '@/components/base/Sidebar.astro';
import Updates from '@/components/base/Updates.astro';
import { siteDescription } from '@/assets/data/site-desc';

const {
    pageTitle = 'Mournstera',
    seoTitle,
    pageDescription = siteDescription,
    pageImage = '/social-default.png',
    mainClass = '',
    hasOwnTitle = false,
} = Astro.props;
---

<html lang="en">
    <head>
        <BaseHead title={seoTitle ?? pageTitle} description={pageDescription} image={pageImage} />
    </head>
    <body>
        <ThemeToggle />

        <div class="grid-line grid-far-left"></div>
        <div class="grid-line grid-left"></div>
        <div class="grid-line grid-right"></div>
        <div class="grid-line grid-far-right"></div>

        <main class:list={[mainClass]}>
            <aside class:list={['sidebars', 'links', { 'fade-in': mainClass === 'homepage' }]}>
                <div class="sidebars-inner">
                    <Sidebar />
                </div>
            </aside>
            <section class="main-content">
                {!hasOwnTitle && pageTitle && <h1>{pageTitle}</h1>}
                <slot />
            </section>

            <aside class:list={['sidebars', 'updates', { 'fade-in': mainClass === 'homepage' }]}>
                <div class="sidebars-inner">
                    <Updates />
                </div>
            </aside>
        </main>
    </body>
</html>
