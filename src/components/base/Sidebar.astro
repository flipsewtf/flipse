---
//Sidebar.astro

import { IconRss } from '@tabler/icons-astro';
import { navLinks } from '@/assets/data/navLinks';
import Monstera from '@/components/base/Monstera.astro';

const current = Astro.url.pathname;
const isActive = (path: string) => current === path;
---

<a class="monstera" href="/" aria-label="Go to homepage" aria-current={isActive('/') ? 'page' : undefined}>
    <Monstera />
</a>

<nav class="main" aria-label="Main">
    <ul>
        {
            navLinks.map((link) => (
                <li>
                    <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<a
    class="subscribe"
    href="/rss.xml"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Subscribe via
            RSS (opens in a new tab)">
    <IconRss />
    <span>Subscribe</span>
</a>

<style>
    a.monstera {
        color: var(--text-alt);
        display: inline-block;
        margin-bottom: var(--space-lg);
        margin-left: -1.875rem;
    }
    a.monstera:hover {
        color: var(--accent);
    }

    nav.main ul {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        font-size: var(--text-sm);
    }

    nav.main ul a {
        color: var(--text);
    }
    nav.main ul a:hover {
        color: var(--accent);
    }
    nav.main ul a[aria-current='page'] {
        color: var(--text-muted);
        padding-left: var(--space-xs);
    }
    a.subscribe {
        display: inline-flex;
        align-items: center;
        gap: var(--space-xs);
        margin: var(--space-lg);
        text-align: center;
        background-color: var(--bg-alt);
        padding: var(--space-xs);
        border-radius: var(--radius-sm);
        font-weight: 600;
        font-size: var(--text-sm);
        letter-spacing: 0;
        color: var(--text-alt);
        margin-left: var(--offset-margin-text);
        box-shadow: var(--box-shadow-content);
    }
    a.subscribe:hover {
        background-color: var(--accent);
        color: var(--accent-light);
    }
    a.subscribe svg {
        stroke-width: 2;
        width: var(--space-md);
        height: var(--space-md);
    }
</style>
