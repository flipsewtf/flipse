---
//SidebarMobile.astro
import { IconMenu2, IconX } from '@tabler/icons-astro';
import NavBox from '../sidebar/NavBox.astro';

import SocialsBox from '../sidebar/SocialsBox.astro';
---

<button
    id="nav-toggle"
    class="nav-toggle"
    aria-expanded="false"
    aria-controls="mobile-sidebar">
    <IconMenu2 class="icon-open" />
    <IconX class="icon-close" />
    <span class="sr-only">Toggle navigation</span>
</button>

<aside id="mobile-sidebar">
    <div class="mobile-inner">
        <NavBox />
        <SocialsBox class="mobile-social" />
    </div>
</aside>

<style>
    .nav-toggle {
        position: fixed;
        top: calc(var(--space-lg) + var(--svg-size) + var(--space-sm));
        right: var(--space-lg);
        z-index: 3;
    }

    .icon-close {
        display: none;
    }

    :global(html:has(body[data-nav-open='true'])) {
        overflow: hidden;
    }

    body[data-nav-open='true'] .icon-open {
        display: none;
    }

    body[data-nav-open='true'] .icon-close {
        display: block;
    }

    #mobile-sidebar {
        position: fixed;
        animation: none;
        inset: 0;
        height: 100%;
        max-height: 100dvh;
        width: 100%;
        overflow-y: auto;
        background-color: var(--bg-trans);
        backdrop-filter: blur(11px);
        z-index: 2;
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
    }

    body[data-nav-open='true'] #mobile-sidebar {
        opacity: 1;
        pointer-events: unset;
        visibility: visible;
    }

    @media (width > 64rem) {
        .nav-toggle,
        #mobile-sidebar {
            display: none;
        }
    }

    .mobile-inner {
        margin-block: auto;
        text-align: center;
        padding: var(--space-xl);
        padding-right: calc(var(--space-lg) + var(--svg-size) + var(--space-sm) * 2);
    }

    nav.mobile svg.paperclip {
        width: 2rem;
        height: 2rem;
        z-index: 3;
        position: absolute;
        margin-top: -0.625rem;
    }

    nav.mobile ul {
        display: inline-flex;
        flex-direction: column;
        gap: var(--space-sm);
        font-size: var(--text-lg);
        font-weight: 700;
        background-color: var(--bg-alt);
        padding: var(--space-xl);
        border-radius: var(--radius-sm);
        min-width: 10rem;
    }

    nav.mobile ul a {
        color: var(--text);
    }
    nav.mobile ul a:hover {
        color: var(--accent);
    }
    nav.mobile ul a[aria-current='page'] {
        color: var(--text-muted);
    }
</style>
<script>
    const toggle = document.getElementById('nav-toggle');
    const sidebar = document.getElementById('mobile-sidebar');

    function setOpen(open: boolean) {
        document.body.dataset.navOpen = String(open);
        toggle?.setAttribute('aria-expanded', String(open));

        if (open) {
            sidebar?.querySelector('a')?.focus();
        } else {
            toggle?.focus();
        }
    }

    toggle?.addEventListener('click', () => {
        const isOpen = document.body.dataset.navOpen === 'true';
        setOpen(!isOpen);
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.dataset.navOpen === 'true') {
            setOpen(false);
        }
    });
</script>
