---
//SidebarMobile.astro
import { IconMenu2, IconX } from '@tabler/icons-astro';
import { navLinks } from '@/assets/data/navLinks';

const current = Astro.url.pathname;
const isActive = (path: string) => current === path;
---

<button
    id="nav-toggle"
    class="nav-toggle"
    aria-expanded="false"
    aria-controls="mobile-sidebar">
    <IconMenu2 class="icon-open" />
    <IconX class="icon-close" />
    <span class="sr-only">Toggle navigation</span>
</button>

<aside id="mobile-sidebar">
    <div class="mobile-inner">
        <nav class="mobile" aria-label="Main">
            <svg class="paperclip"><use href="#paperclip"></use></svg>
            <ul>
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                aria-current={isActive(link.href) ? 'page' : undefined}>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
                <li>
                    <a href="/rss.xml" aria-label="Subscribe via RSS">RSS</a>
                </li>
            </ul>
        </nav>
    </div>
</aside>

<style>
    .nav-toggle {
        color: var(--text-alt);
        position: fixed;
        top: calc(var(--space-lg) + var(--svg-size) + var(--space-sm));
        right: var(--layout-spacing);
        z-index: 3;
    }

    .icon-close {
        display: none;
    }

    :global(html:has(body[data-nav-open='true'])) {
        overflow: hidden;
    }

    body[data-nav-open='true'] .icon-open {
        display: none;
    }

    body[data-nav-open='true'] .icon-close {
        display: block;
    }

    #mobile-sidebar {
        position: fixed;
        animation: none;
        top: 0;
        left: var(--layout-grid-lines);
        height: 100%;
        max-height: 100dvh;
        width: 100%;
        max-width: calc(100dvw - var(--layout-grid-lines) * 2);
        overflow-y: auto;
        background-color: var(--bg);
        z-index: 2;
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
        display: flex;
    }

    body[data-nav-open='true'] #mobile-sidebar {
        opacity: 1;
        pointer-events: unset;
        visibility: visible;
    }

    @media (width > 64rem) {
        .nav-toggle,
        #mobile-sidebar {
            display: none;
        }
    }

    .mobile-inner {
        margin-block: auto;
        margin: auto;
        text-align: center;
        padding: var(--space-xl);
    }

    nav.mobile svg.paperclip {
        width: 2rem;
        height: 2rem;
        z-index: 3;
        position: absolute;
        margin-top: -0.625rem;
    }

    nav.mobile ul {
        display: inline-flex;
        flex-direction: column;
        gap: var(--space-sm);
        font-size: var(--text-lg);
        font-family: var(--font-family--accent);
        font-weight: 700;
        background-color: var(--bg-alt);
        padding: var(--space-xl);
        border-radius: var(--radius-sm);
        min-width: 10rem;
    }

    nav.mobile ul a {
        color: var(--text);
    }
    nav.mobile ul a:hover {
        color: var(--accent);
    }
    nav.mobile ul a[aria-current='page'] {
        color: var(--text-muted);
    }

    @media (width < 28rem) {
        .mobile-inner {
            margin: auto 0 0 auto;
            text-align: right;
        }
        nav.mobile ul {
            align-items: flex-end;
        }
    }
</style>
<script>
    const toggle = document.getElementById('nav-toggle');
    const sidebar = document.getElementById('mobile-sidebar');

    function setOpen(open: boolean) {
        document.body.dataset.navOpen = String(open);
        toggle?.setAttribute('aria-expanded', String(open));

        if (open) {
            sidebar?.querySelector('a')?.focus();
        } else {
            toggle?.focus();
        }
    }

    toggle?.addEventListener('click', () => {
        const isOpen = document.body.dataset.navOpen === 'true';
        setOpen(!isOpen);
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.dataset.navOpen === 'true') {
            setOpen(false);
        }
    });
</script>
