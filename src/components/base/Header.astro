---
//Header.astro

const current = Astro.url.pathname;
const isActive = (path: string) => current === path;
---

<header>
    <a class="home" href="/" aria-current={isActive('/') ? 'page' : undefined}
        >Flipse<span>.</span><span>wtf</span></a
    >

    <button class="theme-toggle" type="button" aria-label="Toggle theme">
        <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
            <path
                class="dark-side-path"
                d="M16 .5C7.4.5.5 7.4.5 16S7.4 31.5 16 31.5 31.5 24.6 31.5 16 24.6.5 16 .5zm0 28.1V3.4C23 3.4 28.6 9 28.6 16S23 28.6 16 28.6z">
            </path>
        </svg>
    </button>
</header>

<style>
    header {
        width: 100%;
        max-width: var(--layout-content);
        margin-inline: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-block: var(--space-xl);
        padding-inline: var(--layout-spacing);
    }
    a.home {
        font-weight: 520;
        font-family: var(--font-family--mono);
        letter-spacing: var(--space-1px);
    }
    a.home span:first-child {
        font-size: 2rem;
        line-height: 0;
        color: var(--accent);
    }
    button.theme-toggle {
        display: inline-flex;
    }
    button.theme-toggle svg {
        fill: currentColor;
        stroke: none;
        width: 1.5rem;
        height: 1.5rem;
    }

    :global(html.no-transition *) {
        transition: none !important;
    }
</style>

<script src="/assets/scripts/theme-toggle.js" is:inline></script>
