                    ></path>
                </svg>
            </a>

            <nav class="header-links" aria-label="Main">
                <ul>
                    <li>
                        <a href="/about">About</a>
                    </li>
                    <li>
                        <a href="/now">Now</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</header>

<style>
    a {
        color: var(--text-alt);
        text-decoration: none;
        font-weight: 600;
    }
    a:hover {
        color: var(--accent-hover);
    }

    header.top {
        width: 100%;
        height: var(--layout--header);
        display: flex;
        align-items: center;
    }

    .header-inner {
        width: 100%;
        max-width: var(--layout--width);
        padding-inline: var(--layout--padding);
        margin: 0 auto;
    }

    .header-nav-wrap {
        display: flex;
        gap: var(--space--sm);
        align-items: center;
        justify-content: space-between;
        padding-right: calc(var(--toggle-size) + var(--space--sm));
    }

    a.monstera {
        position: relative;
        display: inline-flex;
    }

    svg.plant {
        width: 3.75rem;
        height: 3.75rem;
        stroke: none;
        fill: currentColor;
    }

    nav.header-links ul {
        display: flex;
        gap: var(--space--sm);
    }
</style>
<script src="/scripts/nav.js" defer></script>
