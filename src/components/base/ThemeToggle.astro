---
// ThemeToggle.astro
---

<button class="theme-toggle" type="button" aria-label="Toggle theme">
    <svg viewBox="0 0 32 32" aria-hidden="true">
        <path class="toggle-inner" d="M16 9c3.9 0 7 3.1 7 7s-3.1 7-7 7"></path>
        <path
            class="toggle-outer"
            d="M16 .5C7.4.5.5 7.4.5 16S7.4 31.5 16 31.5 31.5 24.6 31.5 16 24.6.5 16 .5zm0 28.1V23c-3.9 0-7-3.1-7-7s3.1-7 7-7V3.4C23 3.4 28.6 9 28.6 16S23 28.6 16 28.6z"
        ></path>
    </svg>
</button>

<style>
    button.theme-toggle {
        color: var(--text);
        position: fixed;
        top: calc((var(--layout--header) - var(--svg-size)) / 2);
        right: max(
            var(--layout--padding),
            calc((100vw - var(--layout--width)) / 2 + var(--layout--padding))
        );
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color var(--transition--smooth);
        color: var(--text-alt);
    }

    button.theme-toggle svg {
        width: var(--toggle-size: );
        height: var(--toggle-size: );
        fill: currentColor;
        stroke: none;
    }

    button.theme-toggle svg path {
        transform-origin: center;

        transition: transform 0.5s ease;
    }

    :global(html[data-theme='dark']) button.theme-toggle .toggle-inner {
        transform: rotate(180deg);
    }

    :global(html[data-theme='dark']) button.theme-toggle .toggle-outer {
        transform: rotate(-180deg);
    }
    :global(html.no-transition *:not(.theme-toggle *)) {
        transition: none !important;
        animation: none !important;
    }
</style>

<script src="/scripts/theme-toggle.js" is:inline></script>
