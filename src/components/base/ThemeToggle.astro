---
// ThemeToggle.astro
---

<button class="theme-toggle" type="button" aria-label="Toggle theme">
    <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
        <path
            class="dark-side-path"
            d="M16 .5C7.4.5.5 7.4.5 16S7.4 31.5 16 31.5 31.5 24.6 31.5 16 24.6.5 16 .5zm0 28.1V3.4C23 3.4 28.6 9 28.6 16S23 28.6 16 28.6z">
        </path>
    </svg>
</button>

<style>
    button.theme-toggle {
        color: var(--text-alt);
        display: inline-flex;
        color: var(--text-alt);
        position: fixed;
        top: var(--space-lg);
        right: var(--corner-spacing);
        display: inline-flex;
        z-index: 3;
    }
    button.theme-toggle svg {
        fill: currentColor;
        stroke: none;
    }

    .dark-side-path {
        transform-origin: center;
        transition: transform 0.4s ease;
    }

    :global(html[data-theme='dark']) .dark-side-path {
        transform: rotate(180deg);
    }

    :global(html.no-transition *:not(.theme-toggle *)) {
        transition: none !important;
    }
    @media (width > 48rem) {
    }
</style>

<script src="/scripts/theme-toggle.js" is:inline></script>
