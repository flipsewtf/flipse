---
//RssBox.astro

import { IconRss } from '@tabler/icons-astro';
const { class: className } = Astro.props;
---

<a
    class:list={['subscribe', className]}
    href="/rss.xml"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Subscribe via RSS (opens in a new tab)">
    <!-- <svg class="rss-bg"><use href="#rss-badge"></use></svg> -->
    <div class="rss-inner">
        <IconRss class="rss-icon" aria-hidden="true" />
        <div class="rss-text">RSS</div>
    </div>
</a>

<style>
    a.subscribe {
        position: relative;
        align-items: center;
        color: var(--bg);
        background-
        border-radius: var(--radius-full);
        border: var(--space-4px) solid var(--text-bold);
        width: 5rem;
        height: 5rem;
    }
    a.subscribe:hover {
        color: var(--accent);
    }

    .rss-inner {
        text-align: center;
        border-radius: var(--radius-full);
        border: var(--space-2px) dashed var(--bg);
        aspect-ratio: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-3px);
    }

    .rss-icon {
        color: inherit;
        stroke-width: 2.5;
        width: 1.25rem;
        height: 1.25rem;
    }
    .rss-text {
        font-family: var(--font-family--mono);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.03125rem;
    }
</style>
