---
//RssBox.astro

import { IconRss } from '@tabler/icons-astro';
---

<a
    class="subscribe"
    href="/rss.xml"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="(opens in a new tab)">
    <!-- <span class="rss-badge"><IconRss /></span> -->
    <span class="rss-text">Subscribe via RSS</span>
    <svg class="rss-badge"><use href="#rss-badge"></use></svg>
</a>

<style>
    a.subscribe {
        /* display: inline-flex; */
        align-items: center;
        gap: var(--space-xs);
        margin-block: var(--space-lg);
        text-align: center;
        background-color: var(--bg-alt);
        padding: var(--space-xs);
        border-radius: var(--radius-sm);
        font-weight: 600;
        font-size: var(--text-sm);
        letter-spacing: 0;
        color: var(--text-alt);
        box-shadow: var(--box-shadow-content);
    }
    a.subscribe:hover {
        background-color: var(--accent);
        color: var(--beige-paper);
    }
    a.subscribe svg {
        stroke-width: 2;
        width: 12rem;
        height: 12rem;
    }
</style>
