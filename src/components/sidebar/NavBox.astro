---
//NavBox.astro

import { navLinks } from '@/assets/data/navLinks';

const current = Astro.url.pathname;
const isActive = (path: string) => current === path;
---

<div class="">
    <nav class="main" aria-label="Main">
        <!-- <svg class="paperclip"><use href="#paperclip"></use></svg> -->
        <ul>
            {
                navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            aria-current={isActive(link.href) ? 'page' : undefined}>
                            {link.label}
                            <svg
                                class="under"
                                viewBox="0 0 24 3"
                                preserveAspectRatio="none"
                                aria-hidden="true">
                                <use href="#underline" />
                            </svg>
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</div>
<style>
    nav.main {
        position: relative;
    }
    nav.main svg.paperclip {
        width: 2rem;
        height: 2rem;
        z-index: 3;
        position: absolute;
        margin-top: -0.8125rem;
        right: 0;
        stroke-width: 1.5px;
        stroke: var(--text);
        rotate: 4deg;
    }
    nav.main::before {
        rotate: 27deg;
        content: '';
        position: absolute;
        z-index: 1;
        border-radius: var(--radius-sm);
        margin-top: -0.125rem;
        right: -1.75rem;
        height: 2rem;
        width: 7rem;
        background-color: var(--tape);
        clip-path: polygon(
            5% 0%,
            95% 0%,
            100% 23%,
            92% 43%,
            95% 75%,
            91% 86%,
            93% 100%,
            2% 100%,
            5% 79%,
            3% 55%,
            8% 38%,
            1% 21%,
            3% 10%
        );
    }
    nav.main ul {
        display: inline-flex;
        flex-direction: column;
        gap: var(--space-sm);
        font-size: var(--text-lg);
        font-family: var(--font-family--accent);
        font-weight: 700;
        background-color: var(--bg-alt);
        padding: var(--space-lg);
        border-radius: var(--radius-sm);
        min-width: 11rem;
        box-shadow: 0px 0px 11px 0 var(--box-shadow);
    }

    nav.main a {
        color: var(--text);
        position: relative;
        display: inline-block;
    }
    nav.main ul a:hover {
        color: var(--accent);
    }

    nav.main .under {
        display: none;
        position: absolute;
        left: 0;
        bottom: var(--space-1px);
        width: 100%;
        height: 3px;
        rotate: 2deg;
    }
    nav.main ul a[aria-current='page'] .under {
        display: block;
    }
</style>
