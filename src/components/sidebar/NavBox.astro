---
//NavBox.astro

import { navLinks } from '@/assets/data/navLinks';

const current = Astro.url.pathname;
const isActive = (path: string) => current === path;
---

<nav class="main" aria-label="Main">
    <ul>
        {
            navLinks.map((link) => (
                <li>
                    <a
                        href={link.href}
                        aria-current={isActive(link.href) ? 'page' : undefined}>
                        {link.label}
                        <svg
                            class="under"
                            viewBox="0 0 24 3"
                            preserveAspectRatio="none"
                            aria-hidden="true">
                            <use href="#underline" />
                        </svg>
                    </a>
                </li>
            ))
        }
        <!-- <li>
            <a
                href="/rss.xml"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Subscribe via RSS (opens in a new tab)">
                RSS
            </a>
        </li> -->
    </ul>
</nav>

<style>
    nav.main ul {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        font-size: var(--text-sm);
        align-items: flex-end;
        font-weight: 700;
        text-transform: lowercase;
    }

    nav.main a {
        position: relative;
        display: inline-block;
    }
    nav.main ul a:hover {
        color: var(--accent);
    }

    nav.main .under {
        display: none;
        position: absolute;
        left: -6%;
        bottom: -0.0625rem;
        width: 112%;
        height: 0.21875rem;
        rotate: 1deg;
        color: inherit;
        stroke: currentColor;
        stroke-width: 1.5;
    }

    nav.main ul a[aria-current='page'] .under {
        display: block;
    }
</style>
